     "emergencies": {
      "policy_id": "emergencies",
      "text": "A gas smell, a carbon monoxide alarm, flooding or electrical danger (sparks, a burning smell) is an emergency. Give the safety advice, open an emergency ticket and transfer the customer to the on-call engineer immediately. Gas: leave the property, do not touch switches or flames, and call the gas emergency line 0800 47 33 33 from outside.",
      "title": "Emergencies"
     },
     "fees": {
      "policy_id": "fees",
      "text": "Call-out fee: 49 EUR, including the first 30 minutes of work. Additional labour: 25 EUR per 15 minutes. Annual boiler service: 89 EUR. Heat pump check: 119 EUR. Emergency visits for gas, carbon monoxide, flooding or electrical danger: no call-out fee.",
      "title": "Prices"
     },
     "hours": {
      "policy_id": "hours",
      "text": "Office: Monday to Friday 08:00-18:00, Saturday 09:00-13:00. Emergency line: 24/7.",
