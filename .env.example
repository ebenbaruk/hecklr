# Copy to .env (git-ignored) and fill in only what you use. Never commit real keys.

# Model providers used by the simulator and judges.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (vLLM, LM Studio, a proxy). Ollama works without this:
# use model strings like ollama/qwen3:8b.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Hard cap for real-model calls in tests marked @pytest.mark.live.
HECKLR_TEST_BUDGET_USD=1
